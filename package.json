{
  "name": "pkj-cli",
  "version": "1.1.0",
  "description": "Interactive package.json script picker & runner — zero dependencies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pkj": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/index.test.js",
    "test:coverage": "echo 'Coverage reporting is not configured yet. Consider adding c8.'",
    "lint": "eslint src/ test/ --ext .ts",
    "lint:fix": "eslint src/ test/ --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test",
    "postversion": "git push && git push --tags"
  },
  "scriptsMeta": {
    "dev": { "desc": "Build and run pkj CLI" },
    "build": { "desc": "Compile TypeScript to dist/" },
    "typecheck": { "desc": "Run TypeScript type check without emitting files" },
    "test": { "desc": "Build and run the test suite" },
    "lint": { "desc": "Check code style with ESLint" },
    "lint:fix": { "desc": "Auto-fix ESLint issues" },
    "format": { "desc": "Format source files with Prettier" },
    "format:check": { "desc": "Check source formatting with Prettier" },
    "clean": { "desc": "Remove build artifacts" },
    "prepublishOnly": { "desc": "Pre-publish hook: typecheck + test + build" }
  },
  "keywords": [
    "cli",
    "package-json",
    "scripts",
    "interactive",
    "picker",
    "runner",
    "npm",
    "yarn",
    "pnpm",
    "bun",
    "productivity",
    "terminal",
    "tui",
    "fuzzy-search"
  ],
  "author": "Tospichai Kumngern <tospichai@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tospichai/pkj-cli.git"
  },
  "bugs": {
    "url": "https://github.com/tospichai/pkj-cli/issues"
  },
  "homepage": "https://github.com/tospichai/pkj-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
